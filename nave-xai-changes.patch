+{
+ "cells": [
+  {
+   "cell_type": "markdown",
+   "id": "1da338c0",
+   "metadata": {},
+   "source": [
+    "# Supervised and self-supervised, block by block\n",
+    "\n",
+    "A demo: the same photos through encoders that differ in their training, supervised on ImageNet labels or\n",
+    "self-supervised (DINO), side by side, for ViT-S/16 and ResNet50. For each model: its tokens at every block,\n",
+    "from the input of block 1 (`b0`) to the last, shown with UMAP and coloured by the model's own concepts at its\n",
+    "last block, with the chosen photo's explanation at every block.\n",
+    "\n",
+    "Models have different numbers of blocks (13 frames for a ViT, 5 for a ResNet), so the rows advance by\n",
+    "**relative depth**: all start at their input and reach their last block together.\n",
+    "\n",
+    "**Needs:** `pip install \"nave-xai[animation]\"`. **Downloads:** each model's weights once (about 90 MB each)."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "c73a44ad",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# %pip install \"nave-xai[animation]\"\n",
+    "import numpy as np\n",
+    "\n",
+    "MODELS = [(\"vits16\", \"imagenet\"), (\"vits16\", \"dino\"), (\"resnet50\", \"imagenet\"), (\"resnet50\", \"dino\")]\n",
+    "K = 8\n",
+    "N_IMAGES = 12\n",
+    "IMAGE = 2                                  # the photo shown (2: the cat); re-run only the drawing cells to change it\n",
+    "UMAP_EPOCHS = 200\n",
+    "SEED = 0\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "dc753b38",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "from matplotlib import animation\n",
+    "from IPython.display import HTML, display\n",
+    "\n",
+    "\n",
+    "def match_colours(labels, reference, K):\n",
+    "    \"\"\"Give every concept of `labels` the colour index of the reference concept it overlaps most\n",
+    "    (one-to-one, maximising the total overlap), so colours stay stable from frame to frame.\"\"\"\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels.ravel(), reference.ravel()), 1)\n",
+    "    try:\n",
+    "        from scipy.optimize import linear_sum_assignment\n",
+    "        rows, cols = linear_sum_assignment(-overlap)\n",
+    "        mapping = dict(zip(rows, cols))\n",
+    "    except ImportError:                                     # greedy, without scipy\n",
+    "        mapping, used = {}, set()\n",
+    "        for a, b in sorted(np.ndindex(K, K), key=lambda ab: -overlap[ab]):\n",
+    "            if a not in mapping and b not in used:\n",
+    "                mapping[a] = b\n",
+    "                used.add(b)\n",
+    "    return np.vectorize(lambda a: mapping.get(a, a))(labels)\n",
+    "\n",
+    "\n",
+    "def knn_agreement(features, targets, k=5, n=1500, seed=0):\n",
+    "    \"\"\"How well a point's k nearest neighbours (cosine) predict its target: leave-one-out accuracy.\"\"\"\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    idx = rng.choice(len(features), min(n, len(features)), replace=False)\n",
+    "    F = features[idx] / np.linalg.norm(features[idx], axis=1, keepdims=True)\n",
+    "    t = targets[idx]\n",
+    "    sim = F @ F.T\n",
+    "    np.fill_diagonal(sim, -np.inf)\n",
+    "    nearest = np.argsort(-sim, axis=1)[:, :k]\n",
+    "    votes = np.array([np.bincount(t[row], minlength=t.max() + 1).argmax() for row in nearest])\n",
+    "    return float((votes == t).mean())\n",
+    "\n",
+    "\n",
+    "def normalise_embedding(e):\n",
+    "    e = e - np.median(e, axis=0)\n",
+    "    return e / np.percentile(np.abs(e), 98)\n",
+    "\n",
+    "\n",
+    "def token_labels(maps, centres):\n",
+    "    \"\"\"The concept at every patch centre of every image: one label per token.\"\"\"\n",
+    "    return np.concatenate([m[np.ix_(centres, centres)].ravel() for m in maps])\n",
+    "\n",
+    "\n",
+    "def match_to(labels, reference, K):\n",
+    "    \"\"\"Rename `labels` so each concept takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    return match_colours(labels, reference, K)\n",
+    "\n",
+    "\n",
+    "def block_names(backbone):\n",
+    "    \"\"\"The input of block 1 (\"b0\"), then every block.\"\"\"\n",
+    "    return [\"b0\"] + list(backbone.blocks)\n",
+    "\n",
+    "\n",
+    "def pool_to(m, gh, gw):\n",
+    "    \"\"\"Average a (C, h, w) map onto a gh x gw grid (each cell: the mean of the cells it covers).\"\"\"\n",
+    "    C, h, w = m.shape\n",
+    "    if (h, w) == (gh, gw):\n",
+    "        return m\n",
+    "    if h % gh == 0 and w % gw == 0:\n",
+    "        return m.reshape(C, gh, h // gh, gw, w // gw).mean((2, 4))\n",
+    "    from skimage.transform import resize\n",
+    "    return resize(m, (C, gh, gw), order=1, anti_aliasing=True, preserve_range=True)\n",
+    "\n",
+    "\n",
+    "def block_tokens(backbone, images, names):\n",
+    "    \"\"\"For every block: the tokens of all images on the deepest block's grid, scaled to length 1.\n",
+    "    Returns (tokens per block, (grid height, grid width), cell size in pixels).\"\"\"\n",
+    "    mean, std = np.array(backbone.mean, np.float32), np.array(backbone.std, np.float32)\n",
+    "    per_block = {n: [] for n in names}\n",
+    "    grid = None\n",
+    "    for img in images:\n",
+    "        x = ((img / 255.0 - mean) / std).astype(np.float32).transpose(2, 0, 1)[None]\n",
+    "        out = backbone(x, names)\n",
+    "        if grid is None:\n",
+    "            grid = out[names[-1]].shape[2:]\n",
+    "        for n in names:\n",
+    "            t = pool_to(out[n][0], *grid)\n",
+    "            per_block[n].append(t.reshape(t.shape[0], -1).T)\n",
+    "    tokens = [np.concatenate(per_block[n]) for n in names]\n",
+    "    tokens = [t / (np.linalg.norm(t, axis=1, keepdims=True) + 1e-12) for t in tokens]\n",
+    "    return tokens, tuple(grid), images[0].shape[0] // grid[0]\n",
+    "\n",
+    "\n",
+    "def cell_centres(size, cell):\n",
+    "    return np.arange(cell // 2, size, cell)\n",
+    "\n",
+    "\n",
+    "def aligned_umap(features, epochs, window=2, regularisation=0.02):\n",
+    "    \"\"\"UMAP of a sequence of point sets (the same points), each frame kept close to its neighbours.\"\"\"\n",
+    "    a = umap.AlignedUMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, alignment_regularisation=regularisation,\n",
+    "                         alignment_window_size=window)\n",
+    "    a.fit(features, relations=[{i: i for i in range(len(features[0]))}] * (len(features) - 1))\n",
+    "    return [normalise_embedding(e) for e in a.embeddings_]\n",
+    "\n",
+    "\n",
+    "def last_reference_umap(features, epochs):\n",
+    "    \"\"\"UMAP of every frame, each starting from the last frame's layout.\"\"\"\n",
+    "    last = umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs).fit_transform(features[-1])\n",
+    "    out = [umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, init=last).fit_transform(f) for f in features[:-1]]\n",
+    "    return [normalise_embedding(e) for e in out + [last]]\n",
+    "\n",
+    "\n",
+    "def renamed_like(labels, reference, K):\n",
+    "    \"\"\"A renaming of concept ids so each takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    from scipy.optimize import linear_sum_assignment\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels, reference), 1)\n",
+    "    r, c = linear_sum_assignment(-overlap)\n",
+    "    rename = np.arange(K)\n",
+    "    rename[r] = c\n",
+    "    return rename\n",
+    "\n",
+    "import warnings\n",
+    "import umap\n",
+    "\n",
+    "warnings.filterwarnings(\"ignore\", module=\"umap\")               # UMAP's notices about threads and seeds\n",
+    "warnings.filterwarnings(\"ignore\", category=FutureWarning)      # scikit-learn's, inside UMAP\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "78fedbf9",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from skimage import data, transform\n",
+    "\n",
+    "names = [\"astronaut\", \"coffee\", \"chelsea\", \"rocket\", \"immunohistochemistry\", \"hubble_deep_field\",\n",
+    "         \"retina\", \"camera\", \"coins\", \"horse\", \"moon\", \"page\"][:N_IMAGES]\n",
+    "\n",
+    "def load(name):\n",
+    "    img = getattr(data, name)()\n",
+    "    img = np.repeat(img[..., None], 3, axis=2) if img.ndim == 2 else img[..., :3]\n",
+    "    return (transform.resize(img, (224, 224), anti_aliasing=False) * 255).astype(np.uint8)\n",
+    "\n",
+    "images = [load(n) for n in names]\n",
+    "fig, axes = plt.subplots(1, len(images), figsize=(1.3 * len(images), 1.5))\n",
+    "for ax, im, n in zip(np.atleast_1d(axes), images, names):\n",
+    "    ax.imshow(im); ax.set_title(n, fontsize=7); ax.axis(\"off\")\n",
+    "# your own photos: see the commented cell in 01_encoder_blocks.ipynb"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "f4a689e1",
+   "metadata": {},
+   "source": [
+    "## One journey per model\n",
+    "\n",
+    "For each model: its tokens at every block (ResNets: averaged onto the last block's grid), its own concepts\n",
+    "at the last block, AlignedUMAP over the blocks, and NAVE fitted on each block alone, for every photo, colours\n",
+    "matched to the last block's."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "38e038e4",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from nave_xai import NAVEImage\n",
+    "\n",
+    "def journey(model, training):\n",
+    "    final = NAVEImage(model, training, k=K, seed=SEED)\n",
+    "    bb = final.backbone\n",
+    "    names_b = block_names(bb)\n",
+    "    final = NAVEImage(bb, layers=[names_b[-1]], k=K, seed=SEED).fit(images)\n",
+    "    tokens, grid, cell = block_tokens(bb, images, names_b)\n",
+    "    centres = cell_centres(224, cell)\n",
+    "    concept = token_labels([e.explanation for e in final.predict(images)], centres)\n",
+    "    palette = final.palette / 255\n",
+    "    views = []\n",
+    "    for name in names_b:\n",
+    "        nave = NAVEImage(bb, layers=[name], k=K, seed=SEED).fit(images)\n",
+    "        exps = nave.predict(images)\n",
+    "        rename = renamed_like(token_labels([e.explanation for e in exps], centres), concept, K)\n",
+    "        views.append([(palette[rename[e.explanation]] * 255).astype(np.uint8) for e in exps])\n",
+    "    return dict(name=f\"{model}, {training}\", names=names_b, emb=aligned_umap(tokens, UMAP_EPOCHS),\n",
+    "                colours=palette[concept], G=grid[0] * grid[1], views=views,\n",
+    "                agreement=[knn_agreement(t, concept, seed=SEED) for t in tokens])\n",
+    "\n",
+    "journeys = [journey(m, t) for m, t in MODELS]\n",
+    "print(\"ready:\", [j[\"name\"] for j in journeys])"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "eb6bb47b",
+   "metadata": {},
+   "source": [
+    "## The animation\n",
+    "\n",
+    "One row per model; the horizontal axis of the curves is relative depth (0: input of block 1, 1: last block)."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "8d2add98",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def animate_models(frames=60):\n",
+    "    n = len(journeys)\n",
+    "    plt.rcParams[\"animation.embed_limit\"] = 100\n",
+    "    fig = plt.figure(figsize=(9.5, 2.8 * n + 1.5), dpi=60)\n",
+    "    grid_ = fig.add_gridspec(n + 1, 3, height_ratios=[3] * n + [1.1], hspace=0.35)\n",
+    "    ax_in = fig.add_subplot(grid_[:n, 0]); ax_in.imshow(images[IMAGE]); ax_in.axis(\"off\")\n",
+    "    ax_in.set_title(f\"input: {names[IMAGE]}\", fontsize=9)\n",
+    "    curve = fig.add_subplot(grid_[n, :])\n",
+    "    arts = []\n",
+    "    for r, j in enumerate(journeys):\n",
+    "        mine = np.arange(IMAGE * j[\"G\"], (IMAGE + 1) * j[\"G\"])\n",
+    "        a_u, a_e = fig.add_subplot(grid_[r, 1]), fig.add_subplot(grid_[r, 2])\n",
+    "        for a in (a_u, a_e):\n",
+    "            a.set_xticks([]); a.set_yticks([])\n",
+    "        a_u.set_xlim(-1.4, 1.4); a_u.set_ylim(-1.4, 1.4); a_u.set_ylabel(j[\"name\"], fontsize=9)\n",
+    "        every = a_u.scatter(*j[\"emb\"][0].T, c=j[\"colours\"], s=4, linewidths=0)\n",
+    "        sel = a_u.scatter(*j[\"emb\"][0][mine].T, c=j[\"colours\"][mine], s=16, edgecolors=\"black\", linewidths=0.4)\n",
+    "        im = a_e.imshow(j[\"views\"][0][IMAGE])\n",
+    "        if r == 0:\n",
+    "            a_u.set_title(\"UMAP of all tokens\", fontsize=9); a_e.set_title(\"NAVE explanation\", fontsize=9)\n",
+    "        depth = np.linspace(0, 1, len(j[\"names\"]))\n",
+    "        curve.plot(depth, j[\"agreement\"], marker=\"o\", ms=3, label=j[\"name\"])\n",
+    "        arts.append((j, every, sel, im, mine))\n",
+    "    curve.set_ylim(0, 1); curve.set_xlim(-0.02, 1.02); curve.legend(fontsize=7)\n",
+    "    curve.set_xlabel(\"relative depth (0: input of block 1, 1: last block)\", fontsize=8)\n",
+    "    marker = curve.axvline(0, color=\"black\", lw=1)\n",
+    "    head = fig.suptitle(\"\", fontsize=11)\n",
+    "\n",
+    "    def frame(f):\n",
+    "        d = f / (frames - 1)\n",
+    "        texts = []\n",
+    "        for j, every, sel, im, mine in arts:\n",
+    "            t = d * (len(j[\"names\"]) - 1); i0, w = int(t), t - int(t); i1 = min(i0 + 1, len(j[\"names\"]) - 1)\n",
+    "            pos = (1 - w) * j[\"emb\"][i0] + w * j[\"emb\"][i1]\n",
+    "            every.set_offsets(pos); sel.set_offsets(pos[mine])\n",
+    "            b = int(round(t)); im.set_data(j[\"views\"][b][IMAGE]); texts.append(j[\"names\"][b])\n",
+    "        marker.set_xdata([d, d]); head.set_text(\"  |  \".join(f\"{j['name']}: {t_}\" for (j, *_), t_ in zip(arts, texts)))\n",
+    "        return [marker, head]\n",
+    "\n",
+    "    return animation.FuncAnimation(fig, frame, frames=frames, interval=120, blit=False)\n",
+    "\n",
+    "\n",
+    "anim = animate_models()\n",
+    "display(HTML(anim.to_jshtml()))\n",
+    "anim.save(\"supervised_vs_selfsupervised.gif\", writer=animation.PillowWriter(fps=8), dpi=70)\n",
+    "plt.close()"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "44776505",
+   "metadata": {},
+   "source": [
+    "## Things to look at\n",
+    "\n",
+    "- which model separates its final concepts earlier, in relative depth;\n",
+    "- ViT against ResNet with the same training, and supervised against self-supervised with the same architecture;\n",
+    "- what each model's concepts cover in the photos: objects, parts, textures."
+   ]
