+   "source": [
+    "# Does the explanation survive augmentation?\n",
+    "\n",
+    "A demo: one photo under growing transformations (rotation, zoom, colour shift, noise, blur). NAVE's concepts\n",
+    "are fitted on the original photo only, then every transformed version is explained with them, so a concept\n",
+    "keeps its colour throughout. The curve below shows the share of pixels that keep their concept, once the\n",
+    "geometric transformations are undone.\n",
+    "\n",
+    "**Needs:** `pip install \"nave-xai[animation]\"`. **Downloads:** none with the default ViT-Ti/16."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "ab67e8c8",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# %pip install \"nave-xai[animation]\"\n",
+    "import numpy as np\n",
+    "\n",
+    "MODEL, TRAINING = \"vitt16\", \"imagenet\"    # or \"resnet50\", \"vits16\" with \"dino\", ...\n",
+    "K = 8\n",
+    "PHOTO = \"chelsea\"                          # any scikit-image photo, or your own below\n",
+    "FAMILIES = (\"rotation\", \"zoom\", \"colour\", \"noise\", \"blur\")\n",
+    "STEPS = 9                                  # strengths from 0 (none) to 1 (strong)\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "c8696975",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "from matplotlib import animation\n",
+    "from IPython.display import HTML, display\n",
+    "\n",
+    "\n",
+    "def match_colours(labels, reference, K):\n",
+    "    \"\"\"Give every concept of `labels` the colour index of the reference concept it overlaps most\n",
+    "    (one-to-one, maximising the total overlap), so colours stay stable from frame to frame.\"\"\"\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels.ravel(), reference.ravel()), 1)\n",
+    "    try:\n",
+    "        from scipy.optimize import linear_sum_assignment\n",
+    "        rows, cols = linear_sum_assignment(-overlap)\n",
+    "        mapping = dict(zip(rows, cols))\n",
+    "    except ImportError:                                     # greedy, without scipy\n",
+    "        mapping, used = {}, set()\n",
+    "        for a, b in sorted(np.ndindex(K, K), key=lambda ab: -overlap[ab]):\n",
+    "            if a not in mapping and b not in used:\n",
+    "                mapping[a] = b\n",
+    "                used.add(b)\n",
+    "    return np.vectorize(lambda a: mapping.get(a, a))(labels)\n",
+    "\n",
+    "\n",
+    "def knn_agreement(features, targets, k=5, n=1500, seed=0):\n",
+    "    \"\"\"How well a point's k nearest neighbours (cosine) predict its target: leave-one-out accuracy.\"\"\"\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    idx = rng.choice(len(features), min(n, len(features)), replace=False)\n",
+    "    F = features[idx] / np.linalg.norm(features[idx], axis=1, keepdims=True)\n",
+    "    t = targets[idx]\n",
+    "    sim = F @ F.T\n",
+    "    np.fill_diagonal(sim, -np.inf)\n",
+    "    nearest = np.argsort(-sim, axis=1)[:, :k]\n",
+    "    votes = np.array([np.bincount(t[row], minlength=t.max() + 1).argmax() for row in nearest])\n",
+    "    return float((votes == t).mean())\n",
+    "\n",
+    "\n",
+    "def normalise_embedding(e):\n",
+    "    e = e - np.median(e, axis=0)\n",
+    "    return e / np.percentile(np.abs(e), 98)\n",
+    "\n",
+    "\n",
+    "def token_labels(maps, centres):\n",
+    "    \"\"\"The concept at every patch centre of every image: one label per token.\"\"\"\n",
+    "    return np.concatenate([m[np.ix_(centres, centres)].ravel() for m in maps])\n",
+    "\n",
+    "\n",
+    "def match_to(labels, reference, K):\n",
+    "    \"\"\"Rename `labels` so each concept takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    return match_colours(labels, reference, K)\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "281ac8ae",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from skimage import data, transform, color, filters, util\n",
+    "\n",
+    "def load(name, size=224):\n",
+    "    img = getattr(data, name)()\n",
+    "    img = np.repeat(img[..., None], 3, axis=2) if img.ndim == 2 else img[..., :3]\n",
+    "    return (transform.resize(img, (size, size), anti_aliasing=False) * 255).astype(np.uint8)\n",
+    "\n",
+    "image = load(PHOTO)\n",
+    "# your own photo instead:\n",
+    "# from PIL import Image\n",
+    "# image = np.asarray(Image.open(\"my_photo.jpg\").convert(\"RGB\").resize((224, 224)))\n",
+    "plt.imshow(image); plt.axis(\"off\");"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "06f733ab",
+   "metadata": {},
+   "source": [
+    "## The transformations\n",
+    "\n",
+    "Each family has a strength from 0 to 1. Geometric ones (rotation, zoom) also say how to move a label map\n",
+    "the same way, so the original explanation can be compared pixel by pixel; pixels that fall outside the\n",
+    "photo are left out."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "861fe83d",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def augment(img, family, s):\n",
+    "    \"\"\"The transformed photo, and a function moving a label map the same way (None: no geometry).\"\"\"\n",
+    "    f = img / 255.0\n",
+    "    if family == \"rotation\":\n",
+    "        angle = 90 * s\n",
+    "        out = transform.rotate(f, angle, mode=\"reflect\")\n",
+    "        move = lambda lab: transform.rotate(lab.astype(float), angle, order=0, mode=\"constant\", cval=-1,\n",
+    "                                            preserve_range=True).astype(int)\n",
+    "    elif family == \"zoom\":\n",
+    "        z = 1 + 1.5 * s                                  # up to 2.5 x, on the centre\n",
+    "        h = int(round(224 / z)); o = (224 - h) // 2\n",
+    "        crop = lambda a, order: transform.resize(a[o:o + h, o:o + h], (224, 224), order=order,\n",
+    "                                                 anti_aliasing=False, preserve_range=True)\n",
+    "        out = crop(f, 1)\n",
+    "        move = lambda lab: crop(lab.astype(float), 0).astype(int)\n",
+    "    elif family == \"colour\":\n",
+    "        hsv = color.rgb2hsv(f); hsv[..., 0] = (hsv[..., 0] + 0.5 * s) % 1.0\n",
+    "        out, move = color.hsv2rgb(hsv), None\n",
+    "    elif family == \"noise\":\n",
+    "        out, move = util.random_noise(f, var=(0.25 * s) ** 2, rng=0), None\n",
+    "    else:\n",
+    "        out, move = filters.gaussian(f, sigma=4 * s, channel_axis=-1), None\n",
+    "    return (np.clip(out, 0, 1) * 255).astype(np.uint8), move"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "e13325c5",
+   "metadata": {},
+   "source": [
+    "## Concepts from the original, explanations of every version"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "3d8cb826",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from nave_xai import NAVEImage\n",
+    "\n",
+    "explainer = NAVEImage(MODEL, TRAINING, k=K).fit(image)          # concepts of the original photo\n",
+    "reference = explainer.predict(image).explanation\n",
+    "palette = explainer.palette / 255\n",
+    "strengths = np.linspace(0, 1, STEPS)\n",
+    "results = {}\n",
+    "for fam in FAMILIES:\n",
+    "    rows = []\n",
+    "    for s in strengths:\n",
+    "        aug, move = augment(image, fam, s)\n",
+    "        lab = explainer.predict(aug).explanation\n",
+    "        ref = reference if move is None else move(reference)\n",
+    "        valid = ref >= 0\n",
+    "        rows.append(dict(image=aug, explanation=palette[lab], agreement=float((lab[valid] == ref[valid]).mean())))\n",
+    "    results[fam] = rows\n",
+    "    print(f\"{fam:9s} agreement:\", \" \".join(f\"{r['agreement']:.2f}\" for r in rows))"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "0d3e5ad6",
+   "metadata": {},
+   "source": [
+    "## The animation\n",
+    "\n",
+    "One row per family: the transformed photo and its explanation; the curves give the agreement with the\n",
+    "original's explanation as the strength grows."
+   ]
+  },
+  {
+   "cell_type": "code",
