+   "outputs": [],
+   "source": [
+    "# %pip install \"nave-xai[animation]\" ipywidgets\n",
+    "import numpy as np\n",
+    "\n",
+    "MODEL, TRAINING = \"vitt16\", \"imagenet\"    # or \"resnet50\", ...\n",
+    "K = 8\n",
+    "N_IMAGES = 12\n",
+    "CROPS = 4                                  # random crops per photo, for context in the scatter\n",
+    "IMAGE = 2                                  # the photo in colour (2: the cat)\n",
+    "GRID = 28                                  # the atlas is GRID x GRID patches\n",
+    "UMAP_EPOCHS = 200\n",
+    "SEED = 0\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "8454ba1c",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "from matplotlib import animation\n",
+    "from IPython.display import HTML, display\n",
+    "\n",
+    "\n",
+    "def match_colours(labels, reference, K):\n",
+    "    \"\"\"Give every concept of `labels` the colour index of the reference concept it overlaps most\n",
+    "    (one-to-one, maximising the total overlap), so colours stay stable from frame to frame.\"\"\"\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels.ravel(), reference.ravel()), 1)\n",
+    "    try:\n",
+    "        from scipy.optimize import linear_sum_assignment\n",
+    "        rows, cols = linear_sum_assignment(-overlap)\n",
+    "        mapping = dict(zip(rows, cols))\n",
+    "    except ImportError:                                     # greedy, without scipy\n",
+    "        mapping, used = {}, set()\n",
+    "        for a, b in sorted(np.ndindex(K, K), key=lambda ab: -overlap[ab]):\n",
+    "            if a not in mapping and b not in used:\n",
+    "                mapping[a] = b\n",
+    "                used.add(b)\n",
+    "    return np.vectorize(lambda a: mapping.get(a, a))(labels)\n",
+    "\n",
+    "\n",
+    "def knn_agreement(features, targets, k=5, n=1500, seed=0):\n",
+    "    \"\"\"How well a point's k nearest neighbours (cosine) predict its target: leave-one-out accuracy.\"\"\"\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    idx = rng.choice(len(features), min(n, len(features)), replace=False)\n",
+    "    F = features[idx] / np.linalg.norm(features[idx], axis=1, keepdims=True)\n",
+    "    t = targets[idx]\n",
+    "    sim = F @ F.T\n",
+    "    np.fill_diagonal(sim, -np.inf)\n",
+    "    nearest = np.argsort(-sim, axis=1)[:, :k]\n",
+    "    votes = np.array([np.bincount(t[row], minlength=t.max() + 1).argmax() for row in nearest])\n",
+    "    return float((votes == t).mean())\n",
+    "\n",
+    "\n",
+    "def normalise_embedding(e):\n",
+    "    e = e - np.median(e, axis=0)\n",
+    "    return e / np.percentile(np.abs(e), 98)\n",
+    "\n",
+    "\n",
+    "def token_labels(maps, centres):\n",
+    "    \"\"\"The concept at every patch centre of every image: one label per token.\"\"\"\n",
+    "    return np.concatenate([m[np.ix_(centres, centres)].ravel() for m in maps])\n",
+    "\n",
+    "\n",
+    "def match_to(labels, reference, K):\n",
+    "    \"\"\"Rename `labels` so each concept takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    return match_colours(labels, reference, K)\n",
+    "\n",
+    "\n",
+    "def block_names(backbone):\n",
+    "    \"\"\"The input of block 1 (\"b0\"), then every block.\"\"\"\n",
+    "    return [\"b0\"] + list(backbone.blocks)\n",
+    "\n",
+    "\n",
+    "def pool_to(m, gh, gw):\n",
+    "    \"\"\"Average a (C, h, w) map onto a gh x gw grid (each cell: the mean of the cells it covers).\"\"\"\n",
+    "    C, h, w = m.shape\n",
+    "    if (h, w) == (gh, gw):\n",
+    "        return m\n",
+    "    if h % gh == 0 and w % gw == 0:\n",
+    "        return m.reshape(C, gh, h // gh, gw, w // gw).mean((2, 4))\n",
+    "    from skimage.transform import resize\n",
+    "    return resize(m, (C, gh, gw), order=1, anti_aliasing=True, preserve_range=True)\n",
+    "\n",
+    "\n",
+    "def block_tokens(backbone, images, names):\n",
+    "    \"\"\"For every block: the tokens of all images on the deepest block's grid, scaled to length 1.\n",
+    "    Returns (tokens per block, (grid height, grid width), cell size in pixels).\"\"\"\n",
+    "    mean, std = np.array(backbone.mean, np.float32), np.array(backbone.std, np.float32)\n",
+    "    per_block = {n: [] for n in names}\n",
+    "    grid = None\n",
+    "    for img in images:\n",
+    "        x = ((img / 255.0 - mean) / std).astype(np.float32).transpose(2, 0, 1)[None]\n",
+    "        out = backbone(x, names)\n",
+    "        if grid is None:\n",
+    "            grid = out[names[-1]].shape[2:]\n",
+    "        for n in names:\n",
+    "            t = pool_to(out[n][0], *grid)\n",
+    "            per_block[n].append(t.reshape(t.shape[0], -1).T)\n",
+    "    tokens = [np.concatenate(per_block[n]) for n in names]\n",
+    "    tokens = [t / (np.linalg.norm(t, axis=1, keepdims=True) + 1e-12) for t in tokens]\n",
+    "    return tokens, tuple(grid), images[0].shape[0] // grid[0]\n",
+    "\n",
+    "\n",
+    "def cell_centres(size, cell):\n",
+    "    return np.arange(cell // 2, size, cell)\n",
+    "\n",
+    "\n",
+    "def aligned_umap(features, epochs, window=2, regularisation=0.02):\n",
+    "    \"\"\"UMAP of a sequence of point sets (the same points), each frame kept close to its neighbours.\"\"\"\n",
+    "    a = umap.AlignedUMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, alignment_regularisation=regularisation,\n",
+    "                         alignment_window_size=window)\n",
+    "    a.fit(features, relations=[{i: i for i in range(len(features[0]))}] * (len(features) - 1))\n",
+    "    return [normalise_embedding(e) for e in a.embeddings_]\n",
+    "\n",
+    "\n",
+    "def last_reference_umap(features, epochs):\n",
+    "    \"\"\"UMAP of every frame, each starting from the last frame's layout.\"\"\"\n",
+    "    last = umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs).fit_transform(features[-1])\n",
+    "    out = [umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, init=last).fit_transform(f) for f in features[:-1]]\n",
+    "    return [normalise_embedding(e) for e in out + [last]]\n",
+    "\n",
+    "\n",
+    "def renamed_like(labels, reference, K):\n",
+    "    \"\"\"A renaming of concept ids so each takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    from scipy.optimize import linear_sum_assignment\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels, reference), 1)\n",
+    "    r, c = linear_sum_assignment(-overlap)\n",
+    "    rename = np.arange(K)\n",
+    "    rename[r] = c\n",
+    "    return rename\n",
+    "\n",
+    "import warnings\n",
+    "import umap\n",
+    "\n",
