+   "outputs": [],
+   "source": [
+    "def animate_augmentation(frames_per_step=3):\n",
+    "    n = len(FAMILIES)\n",
+    "    fig = plt.figure(figsize=(9, 2.4 * n), dpi=60)\n",
+    "    grid = fig.add_gridspec(n, 3, width_ratios=[1, 1, 1.6], hspace=0.25, wspace=0.15)\n",
+    "    arts = []\n",
+    "    for r, fam in enumerate(FAMILIES):\n",
+    "        a0, a1, a2 = (fig.add_subplot(grid[r, j]) for j in range(3))\n",
+    "        for a in (a0, a1):\n",
+    "            a.set_xticks([]); a.set_yticks([])\n",
+    "        a0.set_ylabel(fam, fontsize=10)\n",
+    "        if r == 0:\n",
+    "            a0.set_title(\"transformed\", fontsize=9); a1.set_title(\"NAVE explanation\", fontsize=9)\n",
+    "            a2.set_title(\"agreement with the original\", fontsize=9)\n",
+    "        i0 = a0.imshow(results[fam][0][\"image\"]); i1 = a1.imshow(results[fam][0][\"explanation\"])\n",
+    "        a2.plot(strengths, [x[\"agreement\"] for x in results[fam]], color=\"0.5\", marker=\"o\", ms=3)\n",
+    "        a2.set_ylim(0, 1.02); a2.set_xlim(0, 1); a2.tick_params(labelsize=7)\n",
+    "        m = a2.axvline(0, color=\"black\", lw=1)\n",
+    "        arts.append((fam, i0, i1, m))\n",
+    "    head = fig.suptitle(\"\", fontsize=11)\n",
+    "\n",
+    "    def frame(f):\n",
+    "        k = min(f // frames_per_step, STEPS - 1)\n",
+    "        for fam, i0, i1, m in arts:\n",
+    "            i0.set_data(results[fam][k][\"image\"]); i1.set_data(results[fam][k][\"explanation\"])\n",
+    "            m.set_xdata([strengths[k]] * 2)\n",
+    "        head.set_text(f\"strength {strengths[k]:.2f}\")\n",
+    "        return [a for t in arts for a in t[1:]] + [head]\n",
+    "\n",
+    "    return animation.FuncAnimation(fig, frame, frames=STEPS * frames_per_step, interval=150, blit=False)\n",
+    "\n",
+    "\n",
+    "plt.rcParams[\"animation.embed_limit\"] = 100\n",
+    "anim = animate_augmentation()\n",
+    "display(HTML(anim.to_jshtml()))\n",
+    "anim.save(\"augmentation.gif\", writer=animation.PillowWriter(fps=6), dpi=70)\n",
+    "plt.close()"
+   ]
