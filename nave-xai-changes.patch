+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "if not is_vit:\n",
+    "    print(\"Artifact tokens are a ViT phenomenon: this section is for ViT models.\")\n",
+    "else:\n",
+    "    last_uncertainty = per_block[-1][\"token_uncertainty\"]\n",
+    "    mean_uncertainty = np.array([last_uncertainty[token_concept == c].mean() if np.any(token_concept == c) else 0\n",
+    "                                 for c in range(K)])\n",
+    "    ARTIFACT = int(np.argmax(mean_uncertainty))            # the most uncertain concept; set it yourself if needed\n",
+    "    print(\"artifact concept (guess):\", ARTIFACT, \"| mean uncertainty per concept:\", np.round(mean_uncertainty, 2))\n",
+    "    labels = np.stack([v[\"token_labels\"] for v in per_block])\n",
+    "    uncert = np.stack([v[\"token_uncertainty\"] for v in per_block])\n",
+    "    art = token_concept == ARTIFACT\n",
+    "    stays = np.flip(np.cumprod(np.flip(labels == ARTIFACT, 0), 0), 0).astype(bool)\n",
+    "    flip = np.where(stays.any(0), stays.argmax(0), len(names_b))\n",
+    "    nb = len(names_b)\n",
+    "    fig, axes = plt.subplots(1, 3, figsize=(13, 3.4))\n",
+    "    axes[0].hist(flip[art], bins=np.arange(-0.5, nb + 0.5), color=palette[ARTIFACT], edgecolor=\"white\")\n",
+    "    axes[0].set_xticks(range(nb), names_b, fontsize=6); axes[0].set_ylabel(\"tokens\")\n",
+    "    axes[0].set_title(\"block where a token joins the artifact concept for good\", fontsize=9)\n",
+    "    before = [uncert[:f, i] for i, f in zip(np.nonzero(art)[0], flip[art]) if f > 0]\n",
+    "    axes[1].plot(range(nb), uncert[:, ~art].mean(1), color=\"0.5\", label=\"other tokens\")\n",
+    "    axes[1].plot(range(nb), [np.mean([b_[k] for b_ in before if len(b_) > k]) if any(len(b_) > k for b_ in before)\n",
+    "                             else np.nan for k in range(nb)], color=palette[ARTIFACT], label=\"artifact tokens, before\")\n",
+    "    axes[1].set_xticks(range(nb), names_b, fontsize=6); axes[1].legend(fontsize=7)\n",
+    "    axes[1].set_title(\"uncertainty before the flip\", fontsize=9)\n",
+    "    origin = np.stack([np.bincount(labels[b][art], minlength=K) for b in range(nb)]).T\n",
+    "    axes[2].stackplot(range(nb), origin, colors=palette, alpha=0.9)\n",
+    "    axes[2].set_xticks(range(nb), names_b, fontsize=6); axes[2].set_title(\"their concept at each block\", fontsize=9)\n",
+    "    fig.tight_layout()"
+   ]
