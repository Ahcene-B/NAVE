+    "    owner = np.where(R.max(1) > 0.1, R.argmax(1), -1)\n",
+    "    s = nave_snapshot(backbone, probe_images[::2], [probe_images[i] for i in SHOW], LAYERS, holder)\n",
+    "    snapshots.append(dict(step=step, concepts=np.bincount(owner[owner >= 0], minlength=C),\n",
+    "                          per_class=np.array([(preds[probe_labels == c] == c).mean() for c in range(C)]), **s))\n",
