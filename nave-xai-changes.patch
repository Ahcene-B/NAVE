+    "    grid_ = fig.add_gridspec(len(rows) + 1, n_cols, height_ratios=[3] * len(rows) + [0.9], hspace=0.35)\n",
+    "    ax_in = fig.add_subplot(grid_[:len(rows), 0])\n",
+    "    ax_in.imshow(images[IMAGE]); ax_in.set_title(f\"input: {names[IMAGE]}\", fontsize=9); ax_in.axis(\"off\")\n",
