+    "    exps = nave.predict(show_images, uncertainty=True)\n",
+    "    try:\n",
+    "        saliency = [nave.saliency(im).astype(np.float16) for im in show_images]\n",
+    "    except ValueError:                                          # a model without classifier head\n",
+    "        saliency = [np.zeros(im.shape[:2], np.float16) for im in show_images]\n",
+    "    out = dict(labels=[e.explanation for e in exps], uncertainty=[e.uncertainty.astype(np.float16) for e in exps],\n",
+    "               saliency=saliency)\n",
+    "    feats, grid, cell = composite_patches(backbone, cloud_holder[\"images\"], layers)\n",
+    "    if \"cloud\" not in cloud_holder:\n",
+    "        cloud_holder[\"cloud\"] = PatchCloud(len(cloud_holder[\"images\"]), grid[0] * grid[1], cloud_holder[\"show\"],\n",
+    "                                           N_GRAY, SEED)\n",
+    "        cloud_holder[\"centres\"] = cell_centres(cloud_holder[\"images\"][0].shape[0], cell)\n",
+    "    out[\"cloud\"] = cloud_holder[\"cloud\"].gather(feats)\n",
+    "    return out\n",
+    "\n",
+    "model = torchvision.models.resnet34(num_classes=len(class_names)).to(DEVICE)\n",
+    "optimiser = torch.optim.SGD(model.parameters(), lr=0.1, momentum=0.9, weight_decay=5e-4, nesterov=True)\n",
+    "schedule = torch.optim.lr_scheduler.OneCycleLR(optimiser, max_lr=0.1, total_steps=EPOCHS * len(loader))\n",
+    "backbone = TorchBackbone(model, mean=MEAN, std=STD, device=DEVICE)\n",
+    "holder = dict(images=probe_images, show=SHOW)\n",
+    "C = len(class_names)\n",
+    "snapshots = []\n",
+    "\n",
+    "@torch.no_grad()\n",
+    "def snapshot(step):\n",
+    "    model.eval()\n",
+    "    preds = torch.cat([model(normalise(b).to(DEVICE)).argmax(1).cpu() for b in probe.split(100)]).numpy()\n",
+    "    nave = NAVEImage(backbone, layers=LAYERS, k=K, seed=SEED).fit(probe_images)\n",
+    "    props = np.stack([np.bincount(e.explanation.ravel(), minlength=K) / e.explanation.size for e in nave.predict(probe_images)])\n",
