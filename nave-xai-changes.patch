+    "    curve.legend(fontsize=7, loc=\"lower right\")\n",
+    "    arts = []\n",
+    "    for r, (label, emb, views, row_panels) in enumerate(rows):\n",
+    "        for p in row_panels:\n",
+    "            ax = fig.add_subplot(grid_[r, 1 + panels.index(p)]); ax.set_xticks([]); ax.set_yticks([])\n",
+    "            if p == \"umap\":\n",
+    "                ax.set_xlim(-1.4, 1.4); ax.set_ylim(-1.4, 1.4)\n",
+    "                ax.scatter([], [])\n",
+    "                every = ax.scatter(*emb[0].T, c=colours, s=4, linewidths=0)\n",
+    "                sel = ax.scatter(*emb[0][mine].T, c=colours[mine], s=18, edgecolors=\"black\", linewidths=0.4)\n",
+    "                art = (every, sel)\n",
+    "            else:\n",
+    "                art = draw_panel(ax, p, emb, views, 0)\n",
+    "            ax.set_title(f\"{TITLES[p]} ({label})\", fontsize=8)\n",
+    "            arts.append((p, art, emb, views))\n",
+    "    head = fig.suptitle(\"\", fontsize=11)\n",
+    "\n",
+    "    def frame(f):\n",
+    "        t = f / steps; i0, w = int(t), t - int(t); i1 = min(i0 + 1, n - 1); b = int(round(t))\n",
+    "        for p, art, emb, views in arts:\n",
+    "            if p == \"umap\":\n",
+    "                pos = (1 - w) * emb[i0] + w * emb[i1]\n",
