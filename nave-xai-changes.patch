+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "4a49b279",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def per_block_views(layer_names, with_saliency):\n",
+    "    \"\"\"For every block: NAVE fitted on that block alone (all photos), its concepts renamed after the last\n",
+    "    block's they overlap most (stable colours). Stored for every photo: explanation, uncertainty and,\n",
+    "    optionally, NAVE saliency, so the drawings can switch photo without recomputing.\"\"\"\n",
+    "    views, targets = [], None\n",
+    "    for name in layer_names:\n",
+    "        nave = NAVEImage(backbone, layers=[name], k=K, seed=SEED).fit(images)\n",
+    "        exps = nave.predict(images, uncertainty=True)\n",
+    "        lab = token_labels([e.explanation for e in exps], centres)\n",
+    "        rename = renamed_like(lab, token_concept, K)\n",
+    "        v = dict(token_labels=rename[lab], token_uncertainty=token_labels([e.uncertainty for e in exps], centres),\n",
+    "                 explanation=[(palette[rename[e.explanation]] * 255).astype(np.uint8) for e in exps],\n",
+    "                 uncertainty=[e.uncertainty.astype(np.float16) for e in exps])\n",
+    "        if with_saliency:\n",
+    "            if targets is None:\n",
+    "                targets = [nave._predict_class(*nave._prepare(im)) for im in images]\n",
+    "            try:\n",
+    "                v[\"saliency\"] = [nave.saliency(im, target=t).astype(np.float16) for im, t in zip(images, targets)]\n",
+    "            except ValueError:                 # ResNets: the classifier only reads the last block's channels\n",
+    "                v[\"saliency\"] = [np.zeros(im.shape[:2], np.float16) for im in images]\n",
+    "        views.append(v)\n",
+    "    return views\n",
+    "\n",
+    "per_block = per_block_views(names_b, \"saliency\" in PANELS)\n",
+    "per_block_2 = per_block_views(names_2, False) if second else None\n",
+    "print(\"per-block views ready\")"
+   ]
+  },
