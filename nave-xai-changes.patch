+    "            else:\n",
+    "                art.set_data(views[b][p][IMAGE].astype(float) if p != \"explanation\" else views[b][p][IMAGE])\n",
+    "        marker.set_xdata([t, t]); head.set_text(f\"{title}{names_b[b]}\")\n",
+    "        return [head, marker]\n",
+    "\n",
+    "    return animation.FuncAnimation(fig, frame, frames=(n - 1) * steps + 1, interval=120, blit=False)\n",
+    "\n",
+    "\n",
+    "anim = animate(emb_previous, title=\"previous block as reference  |  \")\n",
+    "display(HTML(anim.to_jshtml()))\n",
+    "anim.save(\"blocks_previous_reference.gif\", writer=animation.PillowWriter(fps=8), dpi=80)\n",
