+   "id": "e65662d7",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import warnings\n",
+    "import umap\n",
+    "\n",
+    "warnings.filterwarnings(\"ignore\", module=\"umap\")               # UMAP's notices about threads and seeds\n",
+    "warnings.filterwarnings(\"ignore\", category=FutureWarning)      # scikit-learn's, inside UMAP\n",
+    "\n",
+    "emb_previous = aligned_umap(tokens, UMAP_EPOCHS)          # default: each block kept close to its neighbours\n",
+    "emb_last = last_reference_umap(tokens, UMAP_EPOCHS)       # alternative: every block from the last block's layout\n",
+    "emb_2 = aligned_umap(tokens_2, UMAP_EPOCHS) if second else None\n",
+    "print(\"embeddings ready\")"
+   ]
