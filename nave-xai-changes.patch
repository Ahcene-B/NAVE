+    "import torchvision\n",
+    "from nave_xai import NAVEImage\n",
+    "from nave_xai.models import TorchBackbone\n",
+    "def nave_snapshot(backbone, fit_images, show_images, layers, cloud_holder):\n",
+    "    \"\"\"At a checkpoint: NAVE fitted on fit_images; for every showable image its explanation (labels),\n",
+    "    uncertainty and NAVE saliency; and the patch cloud's composite features.\"\"\"\n",
