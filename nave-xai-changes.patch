+{
+ "cells": [
+  {
+   "cell_type": "markdown",
+   "id": "a6c8dcaf",
+   "metadata": {},
+   "source": [
+    "# Overfitting, made visible\n",
+    "\n",
+    "A demo: a ResNet34 trained from scratch on a **small** part of Imagenette, long enough to overfit. Two probe\n",
+    "sets are followed through training: images it **trains on**, and **validation** images it never sees. One row\n",
+    "shows a training image, the other a validation image: their NAVE explanations and their patches in the UMAP\n",
+    "(gray: patches of all other probe images, training and validation). The curves give both accuracies.\n",
+    "\n",
+    "**Needs:** `pip install \"nave-xai[animation]\" torch torchvision`. **Downloads:** Imagenette (about 100 MB) once."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "804b714e",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# %pip install \"nave-xai[animation]\" torch torchvision ipywidgets\n",
+    "import numpy as np\n",
+    "import torch\n",
+    "\n",
+    "FRACTION = 0.05                            # share of the training set used\n",
+    "EPOCHS = 60\n",
+    "PROBE = 100                                # per probe set (training, validation)\n",
+    "K = 8\n",
+    "LAYERS = [\"layer3\", \"layer4\"]\n",
+    "PANELS = (\"input\", \"umap\", \"explanation\", \"uncertainty\")\n",
+    "N_GRAY = 3000                              # patches of other probe images in the UMAP (gray)\n",
+    "UMAP_EPOCHS = 200\n",
+    "SEED = 0\n",
+    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
+    "torch.manual_seed(SEED)\n",
+    "print(\"device:\", DEVICE)\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "acd1ece7",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "from matplotlib import animation\n",
+    "from IPython.display import HTML, display\n",
+    "\n",
+    "\n",
+    "def match_colours(labels, reference, K):\n",
+    "    \"\"\"Give every concept of `labels` the colour index of the reference concept it overlaps most\n",
+    "    (one-to-one, maximising the total overlap), so colours stay stable from frame to frame.\"\"\"\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels.ravel(), reference.ravel()), 1)\n",
+    "    try:\n",
+    "        from scipy.optimize import linear_sum_assignment\n",
+    "        rows, cols = linear_sum_assignment(-overlap)\n",
+    "        mapping = dict(zip(rows, cols))\n",
+    "    except ImportError:                                     # greedy, without scipy\n",
+    "        mapping, used = {}, set()\n",
+    "        for a, b in sorted(np.ndindex(K, K), key=lambda ab: -overlap[ab]):\n",
+    "            if a not in mapping and b not in used:\n",
+    "                mapping[a] = b\n",
+    "                used.add(b)\n",
+    "    return np.vectorize(lambda a: mapping.get(a, a))(labels)\n",
+    "\n",
+    "\n",
+    "def knn_agreement(features, targets, k=5, n=1500, seed=0):\n",
+    "    \"\"\"How well a point's k nearest neighbours (cosine) predict its target: leave-one-out accuracy.\"\"\"\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    idx = rng.choice(len(features), min(n, len(features)), replace=False)\n",
+    "    F = features[idx] / np.linalg.norm(features[idx], axis=1, keepdims=True)\n",
+    "    t = targets[idx]\n",
+    "    sim = F @ F.T\n",
+    "    np.fill_diagonal(sim, -np.inf)\n",
+    "    nearest = np.argsort(-sim, axis=1)[:, :k]\n",
+    "    votes = np.array([np.bincount(t[row], minlength=t.max() + 1).argmax() for row in nearest])\n",
+    "    return float((votes == t).mean())\n",
+    "\n",
+    "\n",
+    "def normalise_embedding(e):\n",
+    "    e = e - np.median(e, axis=0)\n",
+    "    return e / np.percentile(np.abs(e), 98)\n",
+    "\n",
+    "\n",
+    "def block_names(backbone):\n",
+    "    \"\"\"The input of block 1 (\"b0\"), then every block.\"\"\"\n",
+    "    return [\"b0\"] + list(backbone.blocks)\n",
+    "\n",
+    "\n",
+    "def pool_to(m, gh, gw):\n",
+    "    \"\"\"Average a (C, h, w) map onto a gh x gw grid (each cell: the mean of the cells it covers).\"\"\"\n",
+    "    C, h, w = m.shape\n",
+    "    if (h, w) == (gh, gw):\n",
+    "        return m\n",
+    "    if h % gh == 0 and w % gw == 0:\n",
+    "        return m.reshape(C, gh, h // gh, gw, w // gw).mean((2, 4))\n",
+    "    from skimage.transform import resize\n",
+    "    return resize(m, (C, gh, gw), order=1, anti_aliasing=True, preserve_range=True)\n",
+    "\n",
+    "\n",
+    "def block_tokens(backbone, images, names):\n",
+    "    \"\"\"For every block: the tokens of all images on the deepest block's grid, scaled to length 1.\n",
+    "    Returns (tokens per block, (grid height, grid width), cell size in pixels).\"\"\"\n",
+    "    mean, std = np.array(backbone.mean, np.float32), np.array(backbone.std, np.float32)\n",
+    "    per_block = {n: [] for n in names}\n",
+    "    grid = None\n",
+    "    for img in images:\n",
+    "        x = ((img / 255.0 - mean) / std).astype(np.float32).transpose(2, 0, 1)[None]\n",
+    "        out = backbone(x, names)\n",
+    "        if grid is None:\n",
+    "            grid = out[names[-1]].shape[2:]\n",
+    "        for n in names:\n",
+    "            t = pool_to(out[n][0], *grid)\n",
+    "            per_block[n].append(t.reshape(t.shape[0], -1).T)\n",
+    "    tokens = [np.concatenate(per_block[n]) for n in names]\n",
+    "    tokens = [t / (np.linalg.norm(t, axis=1, keepdims=True) + 1e-12) for t in tokens]\n",
+    "    return tokens, tuple(grid), images[0].shape[0] // grid[0]\n",
+    "\n",
+    "\n",
+    "def cell_centres(size, cell):\n",
+    "    return np.arange(cell // 2, size, cell)\n",
+    "\n",
+    "\n",
+    "def aligned_umap(features, epochs, window=2, regularisation=0.02):\n",
+    "    \"\"\"UMAP of a sequence of point sets (the same points), each frame kept close to its neighbours.\"\"\"\n",
+    "    a = umap.AlignedUMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, alignment_regularisation=regularisation,\n",
+    "                         alignment_window_size=window)\n",
+    "    a.fit(features, relations=[{i: i for i in range(len(features[0]))}] * (len(features) - 1))\n",
+    "    return [normalise_embedding(e) for e in a.embeddings_]\n",
+    "\n",
+    "\n",
+    "def last_reference_umap(features, epochs):\n",
+    "    \"\"\"UMAP of every frame, each starting from the last frame's layout.\"\"\"\n",
+    "    last = umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs).fit_transform(features[-1])\n",
+    "    out = [umap.UMAP(n_neighbors=15, min_dist=0.2, n_epochs=epochs, init=last).fit_transform(f) for f in features[:-1]]\n",
+    "    return [normalise_embedding(e) for e in out + [last]]\n",
+    "\n",
+    "\n",
+    "def renamed_like(labels, reference, K):\n",
+    "    \"\"\"A renaming of concept ids so each takes the id of the reference concept it overlaps most.\"\"\"\n",
+    "    from scipy.optimize import linear_sum_assignment\n",
+    "    overlap = np.zeros((K, K))\n",
+    "    np.add.at(overlap, (labels, reference), 1)\n",
+    "    r, c = linear_sum_assignment(-overlap)\n",
+    "    rename = np.arange(K)\n",
+    "    rename[r] = c\n",
+    "    return rename\n",
+    "\n",
+    "import warnings\n",
+    "import umap\n",
+    "\n",
+    "warnings.filterwarnings(\"ignore\", module=\"umap\")               # UMAP's notices about threads and seeds\n",
+    "warnings.filterwarnings(\"ignore\", category=FutureWarning)      # scikit-learn's, inside UMAP\n",
+    "\n",
+    "from nave_xai.composite import CompositeFeatures\n",
+    "\n",
+    "\n",
+    "def to_uint8(x):\n",
+    "    \"\"\"A (3, H, W) tensor in [0, 1] -> an (H, W, 3) uint8 image, for NAVE.\"\"\"\n",
+    "    return (x.permute(1, 2, 0).clamp(0, 1).numpy() * 255).astype(np.uint8)\n",
+    "\n",
+    "\n",
+    "def composite_patches(backbone, images, layers):\n",
+    "    \"\"\"NAVE's composite features of every patch (on the finest chosen layer's grid) of uint8 images:\n",
+    "    (N, patches, D), the grid and the patch size in pixels.\"\"\"\n",
+    "    mean, std = np.array(backbone.mean, np.float32), np.array(backbone.std, np.float32)\n",
+    "    out = []\n",
+    "    for im in images:\n",
+    "        x = ((im / 255.0 - mean) / std).astype(np.float32).transpose(2, 0, 1)[None]\n",
+    "        maps = backbone(x, layers)\n",
+    "        f = CompositeFeatures([maps[n][0] for n in layers], \"nearest\").full()\n",
+    "        out.append(f.reshape(-1, f.shape[-1]))\n",
+    "    return np.stack(out), f.shape[:2], images[0].shape[0] // f.shape[0]\n",
+    "\n",
+    "\n",
+    "class PatchCloud:\n",
+    "    \"\"\"The UMAP's points: a fixed sample of patches of the probe images (drawn in gray) and every patch of\n",
+    "    the images that can be shown (drawn in their concepts' colours).\"\"\"\n",
+    "\n",
+    "    def __init__(self, n_images, n_patches, show, n_gray, seed):\n",
+    "        rng = np.random.default_rng(seed)\n",
+    "        pairs = [(i, g) for i in range(n_images) if i not in show for g in range(n_patches)]\n",
+    "        self.gray = [pairs[p] for p in rng.choice(len(pairs), min(n_gray, len(pairs)), replace=False)]\n",
+    "        self.show, self.G = list(show), n_patches\n",
+    "\n",
+    "    def gather(self, feats):\n",
+    "        gray = np.stack([feats[i, g] for i, g in self.gray])\n",
+    "        return np.concatenate([gray, feats[self.show].reshape(-1, feats.shape[-1])])\n",
+    "\n",
+    "    def of(self, k):\n",
+    "        \"\"\"Indices, among the gathered points, of the k-th showable image's patches.\"\"\"\n",
+    "        start = len(self.gray) + k * self.G\n",
+    "        return np.arange(start, start + self.G)\n",
+    "\n",
+    "\n",
+    "def colour_snapshots(snaps, K, centres):\n",
+    "    \"\"\"Match every checkpoint's concepts to the last checkpoint's (per shown image), and colour them.\"\"\"\n",
+    "    palette = plt.get_cmap(\"Spectral\")(np.linspace(0, 1, K))[:, :3]\n",
+    "    final = snaps[-1][\"labels\"]\n",
+    "    for s in snaps:\n",
+    "        s[\"explanation\"], s[\"patch_colours\"] = [], []\n",
+    "        for lab, ref in zip(s[\"labels\"], final):\n",
+    "            matched = match_colours(lab, ref, K)\n",
+    "            s[\"explanation\"].append(palette[matched])\n",
+    "            s[\"patch_colours\"].append(palette[matched[np.ix_(centres, centres)].ravel()])\n",
+    "    return palette\n",
+    "\n",
+    "\n",
+    "PANEL_TITLES = {\"input\": \"image\", \"umap\": \"UMAP of patches\", \"explanation\": \"NAVE explanation\",\n",
+    "                \"uncertainty\": \"uncertainty\", \"saliency\": \"NAVE saliency\"}\n",
+    "\n",
+    "\n",
+    "def draw(ax, panel, row, k, image):\n",
+    "    \"\"\"The content of one panel at checkpoint k, for shown image `image` (index into SHOW).\"\"\"\n",
+    "    s = row[\"snaps\"][k]\n",
+    "    if panel == \"input\":\n",
+    "        return ax.imshow(row[\"inputs\"][image])\n",
+    "    if panel == \"explanation\":\n",
+    "        return ax.imshow(s[\"explanation\"][image])\n",
+    "    if panel == \"uncertainty\":\n",
+    "        return ax.imshow(s[\"uncertainty\"][image].astype(float), cmap=\"inferno_r\", vmin=0, vmax=1)\n",
+    "    if panel == \"saliency\":\n",
+    "        return ax.imshow(s[\"saliency\"][image].astype(float), cmap=\"seismic\", vmin=-1, vmax=1)\n",
+    "\n",
+    "\n",
+    "def animate_training(rows, curves, image, panels, frames_between=6, title=\"\"):\n",
+    "    \"\"\"rows: [dict(label, snaps, emb, cloud, inputs)]; curves: [(label, values per checkpoint)];\n",
+    "    panels: any of \"input\", \"umap\", \"explanation\", \"uncertainty\", \"saliency\".\"\"\"\n",
+    "    snaps0 = rows[0][\"snaps\"]\n",
+    "    n = len(snaps0)\n",
+    "    plt.rcParams[\"animation.embed_limit\"] = 100\n",
+    "    fig = plt.figure(figsize=(3.0 * len(panels), 3.0 * len(rows) + 1.6), dpi=60)\n",
+    "    grid_ = fig.add_gridspec(len(rows) + 1, len(panels), height_ratios=[3] * len(rows) + [1.1], hspace=0.4)\n",
+    "    arts = []\n",
+    "    for r, row in enumerate(rows):\n",
+    "        img = row.get(\"image\", image)                          # a row may show its own image\n",
+    "        mine = row[\"cloud\"].of(img)\n",
+    "        for j, p in enumerate(panels):\n",
+    "            ax = fig.add_subplot(grid_[r, j]); ax.set_xticks([]); ax.set_yticks([])\n",
+    "            if r == 0:\n",
+    "                ax.set_title(PANEL_TITLES[p], fontsize=9)\n",
+    "            if j == 0:\n",
+    "                ax.set_ylabel(row[\"label\"], fontsize=9)\n",
+    "            if p == \"umap\":\n",
+    "                ax.set_xlim(-1.4, 1.4); ax.set_ylim(-1.4, 1.4)\n",
+    "                every = ax.scatter(*row[\"emb\"][0].T, c=\"0.82\", s=3, linewidths=0)\n",
+    "                sel = ax.scatter(*row[\"emb\"][0][mine].T, c=row[\"snaps\"][0][\"patch_colours\"][img], s=14,\n",
+    "                                 edgecolors=\"black\", linewidths=0.3)\n",
+    "                arts.append((p, row, (every, sel), mine, img))\n",
+    "            else:\n",
+    "                arts.append((p, row, draw(ax, p, row, 0, img), None, img))\n",
+    "    curve = fig.add_subplot(grid_[len(rows), :])\n",
+    "    for label, values in curves:\n",
+    "        curve.plot(range(n), values, marker=\"o\", ms=3, label=label)\n",
+    "    curve.set_xticks(range(n), [str(s[\"step\"]) for s in snaps0], fontsize=6, rotation=45)\n",
+    "    curve.set_ylim(0, 1.02); curve.set_xlabel(\"training step\", fontsize=8); curve.legend(fontsize=7, loc=\"lower right\")\n",
+    "    marker = curve.axvline(0, color=\"black\", lw=1)\n",
+    "    head = fig.suptitle(\"\", fontsize=11)\n",
+    "\n",
+    "    def frame(f):\n",
+    "        t = f / frames_between; i0, w = int(t), t - int(t); i1 = min(i0 + 1, n - 1); k = int(round(t))\n",
+    "        for p, row, art, mine, img in arts:\n",
+    "            if p == \"umap\":\n",
+    "                pos = (1 - w) * row[\"emb\"][i0] + w * row[\"emb\"][i1]\n",
+    "                art[0].set_offsets(pos); art[1].set_offsets(pos[mine])\n",
+    "                art[1].set_facecolor(row[\"snaps\"][k][\"patch_colours\"][img])\n",
+    "            elif p != \"input\":\n",
+    "                s = row[\"snaps\"][k]\n",
+    "                art.set_data(s[\"explanation\"][img] if p == \"explanation\" else s[p][img].astype(float))\n",
+    "        marker.set_xdata([t, t]); head.set_text(f\"{title}training step {snaps0[k]['step']}\")\n",
+    "        return [marker, head]\n",
+    "\n",
+    "    return animation.FuncAnimation(fig, frame, frames=(n - 1) * frames_between + 1, interval=120, blit=False)\n",
+    "\n",
+    "\n",
+    "def show_checkpoint(rows, image, panels, k):\n",
+    "    \"\"\"A still of checkpoint k (for the slider).\"\"\"\n",
+    "    fig, axes = plt.subplots(len(rows), len(panels), figsize=(3.0 * len(panels), 3.0 * len(rows)), squeeze=False)\n",
